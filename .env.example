# 로컬 실행용: 이 파일을 .env.local 로 복사해 값을 채운다 (커밋 금지).
# Vercel 에서는 Project Settings → Environment Variables 에 같은 이름으로 넣는다.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>
# 관리자 로그인 아이디 뒤에 붙는 도메인. 아이디 "admin1" → Supabase 계정 "admin1@<이 값>".
# 실제로 메일을 받는 주소일 필요는 없다. 비우면 passage.invalid (.invalid 는 어디로도 메일이 가지 않는 예약 도메인)
NEXT_PUBLIC_ADMIN_ID_DOMAIN=passage.invalid
# 업데이트 공지에 붙는 스토어 링크 (공지 탭). 서버에서만 읽는다 — NEXT_PUBLIC_ 을 붙이지 않는다.
# https 로 시작해야 한다. 둘 중 하나라도 비어 있으면 업데이트 공지는 게시할 수 없다 (안내 공지는 된다).
NOTICE_ANDROID_URL=
NOTICE_IOS_URL=
# 정산 · 파일 탭 예상 계산안 단가 (1회 몇 원, 예: 2.5). 저장소에 두지 않으려고 환경 변수로 넣는다.
# 비우면 예상 금액을 계산하지 않는다. NEXT_PUBLIC_ 이라 화면(로그인한 관리자)에는 보인다.
NEXT_PUBLIC_ESTIMATE_WON_PER_PLAY=
